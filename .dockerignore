# Secrets - load-bearing. Without this the Telegram token is baked into a layer.
.env

# Virtualenv, VCS, caches
env/
venv/
.git/
.gitignore
__pycache__/
**/__pycache__/
.pytest_cache/

# Mounted at runtime, not copied
models/
footage/
logs/
src/config/

# Local-only and dev material
videos/
runs/
context/
scripts/
notes.txt
test.py
main.py
docs/

# Test suites: host-side only (see spec's "tests stay host-side" non-goal).
# Without this, `COPY src/ src/` bakes every src/*/tests/ dir into the image --
# dead weight that can never run there.
**/tests/

# Rebuilt inside the image by the node stage
web/node_modules/
web/dist/
